# Copy to .env for local dev. Never commit the real .env.

# Base URL of the SKHPortal backend API (the Express service).
# Local: http://localhost:4000 · Production: the backend's Railway URL/domain.
NEXT_PUBLIC_API_URL="http://localhost:4000"

# Supabase — authentication only (added in Phase 4). Public, client-safe keys.
NEXT_PUBLIC_SUPABASE_URL=""
NEXT_PUBLIC_SUPABASE_ANON_KEY=""
