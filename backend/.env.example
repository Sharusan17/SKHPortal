# Database (PostgreSQL on Railway — also used by Prisma & pgAdmin)
DATABASE_URL="postgresql://USER:PASSWORD@HOST:PORT/DATABASE?schema=public"

# Server (Railway sets PORT automatically in production)
PORT=3001
NODE_ENV=development

# CORS — frontend origin(s), comma-separated
CORS_ORIGIN="http://localhost:3000"

# Email notifications for enquiries (provider e.g. Resend)
RESEND_API_KEY=""
ENQUIRY_NOTIFY_TO="info@skhinc.co.uk"
ENQUIRY_FROM="SKH Inc <noreply@skhinc.co.uk>"

# Supabase auth verification (Phase 4 — secret, server only)
SUPABASE_URL=""
SUPABASE_JWT_SECRET=""
SUPABASE_SERVICE_ROLE_KEY=""
