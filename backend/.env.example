# Copy to .env for local dev. Railway injects these in production.

# Standalone PostgreSQL (Railway). Also used by pgAdmin and Prisma.
DATABASE_URL="postgresql://USER:PASSWORD@HOST:PORT/DATABASE?schema=public"

# Port the API listens on (Railway sets PORT automatically in production).
PORT=4000

# Allowed frontend origin(s) for CORS, comma-separated.
CORS_ORIGIN="http://localhost:3000"
