# =============================================================================
# SKHPortal website (apps/web) — copy to apps/web/.env for local use.
# On Railway, put the same names in the frontend service's Variables tab instead.
# =============================================================================

# The API (apps/api). Railway: its public URL, https://<api domain>. Locally:
NEXT_PUBLIC_API_URL=http://localhost:3001

# This site's own address (used for page metadata). Railway: https://<your site>. Locally:
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# The admin service, which the site serves at /admin.
# Railway: http://<admin service name>.railway.internal:8080   Locally:
ADMIN_URL=http://127.0.0.1:8501
