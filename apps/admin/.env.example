# ---- Admin sign-in (required: without these nobody can sign in)
# Make the hash and secret with:  cd apps/admin && python api/auth.py
ADMIN_EMAIL=
ADMIN_PASSWORD_HASH=
SESSION_SECRET=

# ---- Where the data lives (database, receipts, invoices, logo). Defaults to apps/admin/data.
# On Railway this is /data, a volume.
# DATA_DIR=

# Companies House REST API key (developer.company-information.service.gov.uk)
COMPANIES_HOUSE_API_KEY=

# HMRC Developer Hub application subscribed to "Check a UK VAT number" v2
HMRC_CLIENT_ID=
HMRC_CLIENT_SECRET=
# true = test-api.service.hmrc.gov.uk (sandbox credentials)
HMRC_USE_SANDBOX=false

# Vehicle lookup by reg. DVLA Vehicle Enquiry Service key (register-for-ves.driver-vehicle-licensing.api.gov.uk)
DVLA_API_KEY=

# DVSA MOT history API (documentation.history.mot.api.gov.uk): sent to you when access is approved
MOT_CLIENT_ID=
MOT_CLIENT_SECRET=
MOT_API_KEY=
MOT_TOKEN_URL=
# usually https://tapi.dvsa.gov.uk/.default
MOT_SCOPE=
