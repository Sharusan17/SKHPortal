# =============================================================================
# SKHPortal admin (apps/admin) — copy to apps/admin/.env for local use.
# On Railway, put the same names in the admin service's Variables tab instead.
# =============================================================================

# ---- Database (required) -----------------------------------------------------
# Railway:  DATABASE_URL=${{Postgres.DATABASE_URL}}
# Locally:  the Postgres service's DATABASE_PUBLIC_URL, or a local Postgres
DATABASE_URL=postgresql://USER:PASSWORD@HOST:5432/DATABASE
# Schema the admin's tables live in. Railway: admin. Locally against the Railway
# database use admin_dev, so testing never touches the real data.
ADMIN_DB_SCHEMA=admin

# ---- Sign-in (required: without these nobody can sign in) ------------------
# Make the hash and secret with:  cd apps/admin && python api/auth.py
ADMIN_EMAIL=
ADMIN_PASSWORD_HASH=
SESSION_SECRET=

# ---- Server -----------------------------------------------------------------
# Railway: 8080 (the website's ADMIN_URL points at it). Locally: 8501.
PORT=8501
# 1 = session cookie only over HTTPS. The Dockerfile sets 1 on Railway; leave 0 locally.
COOKIE_SECURE=0
# Local working copy of stored files, rebuilt from Postgres on start (optional)
# DATA_DIR=

# ---- Lookups (optional: each feature stays off until its key is set) ---------
# Companies House REST API key (developer.company-information.service.gov.uk)
COMPANIES_HOUSE_API_KEY=

# HMRC Developer Hub application subscribed to "Check a UK VAT number" v2
HMRC_CLIENT_ID=
HMRC_CLIENT_SECRET=
# true = test-api.service.hmrc.gov.uk (sandbox credentials)
HMRC_USE_SANDBOX=false

# DVLA Vehicle Enquiry Service key, for lookup by reg (register-for-ves.driver-vehicle-licensing.api.gov.uk)
DVLA_API_KEY=

# DVSA MOT history API (documentation.history.mot.api.gov.uk): sent to you when access is approved
MOT_CLIENT_ID=
MOT_CLIENT_SECRET=
MOT_API_KEY=
MOT_TOKEN_URL=
MOT_SCOPE=https://tapi.dvsa.gov.uk/.default
