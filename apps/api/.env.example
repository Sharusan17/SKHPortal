# =============================================================================
# SKHPortal API (apps/api) — copy to apps/api/.env for local use.
# On Railway, put the same names in the backend service's Variables tab instead.
# =============================================================================

# ---- Database (required) -----------------------------------------------------
# Railway:  DATABASE_URL=${{Postgres.DATABASE_URL}}
# Locally:  the Postgres service's DATABASE_PUBLIC_URL, or a local Postgres
DATABASE_URL=postgresql://USER:PASSWORD@HOST:5432/DATABASE?schema=public

# ---- Server -----------------------------------------------------------------
# Railway sets PORT itself; locally 3001
PORT=3001
NODE_ENV=development

# Website address(es) allowed to call the API, comma-separated.
# Railway: https://<your site>   Locally: http://localhost:3000
CORS_ORIGIN=http://localhost:3000
