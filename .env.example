# Copy to .env and fill in. Never commit the real .env.

# Standalone PostgreSQL (Railway) — app data, viewed in pgAdmin.
# Used by Prisma from Phase 1 (enquiries) onward.
DATABASE_URL="postgresql://USER:PASSWORD@HOST:PORT/DATABASE?schema=public"

# Supabase — authentication only (added in Phase 4).
NEXT_PUBLIC_SUPABASE_URL=""
NEXT_PUBLIC_SUPABASE_ANON_KEY=""

# Email notifications for enquiry submissions (provider TBD, e.g. Resend).
EMAIL_API_KEY=""
ENQUIRY_NOTIFY_TO="info@skhinc.co.uk"
